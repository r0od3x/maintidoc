# Copier en `.env` et renseigner localement. `.env` est exclu de Git.
# Aucun secret réel ne doit figurer dans ce fichier d'exemple.

# --- Modèles ---------------------------------------------------------------
# ATTENTION : « qwen3.8:27b » du prototype n'est pas un tag Ollama réel et
# n'est pas multimodal. Vérifier le tag disponible avec `ollama list`.
MAINTIDOC_VLM_MODEL=qwen2.5vl:7b
MAINTIDOC_OLLAMA_HOST=http://127.0.0.1:11434
MAINTIDOC_EMBEDDING_MODEL=BAAI/bge-m3
MAINTIDOC_VISUAL_ENCODER=jinaai/jina-clip-v2
MAINTIDOC_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# --- OCR (phase 2) ---------------------------------------------------------
# Laisser vide pour autodetection (PATH puis emplacements usuels).
MAINTIDOC_TESSERACT_CMD=
MAINTIDOC_TESSDATA_DIR=

# --- Stockage (phases 2-3) -------------------------------------------------
MAINTIDOC_QDRANT_URL=http://127.0.0.1:6333
MAINTIDOC_POSTGRES_DSN=postgresql://maintidoc:change-me@127.0.0.1:5432/maintidoc
MAINTIDOC_MINIO_ENDPOINT=http://127.0.0.1:9000
MAINTIDOC_MINIO_ACCESS_KEY=
MAINTIDOC_MINIO_SECRET_KEY=

# --- Sécurité (phases 6-8) -------------------------------------------------
MAINTIDOC_JWT_SECRET=
MAINTIDOC_APPROVAL_TOKEN_TTL_SECONDS=900

# --- Versions de corpus / index (traçabilité) ------------------------------
MAINTIDOC_CORPUS_VERSION=dev
MAINTIDOC_INDEX_VERSION=dev

# --- Docker Compose (lu directement par compose, sans préfixe) -------------
POSTGRES_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
